{
  "name": "ai-video-editor",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first AI video editor for Windows",
  "author": "AI Video Editor",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.main.json --noEmit",
    "test": "vitest run",
    "test:media": "node scripts/test-media.cjs",
    "test:live-agent": "node scripts/test-live-agent.cjs",
    "dist:win": "node scripts/verify-win-packaging.cjs && npm run typecheck && npm test && npm run test:media && npm run build && electron-builder --win nsis --x64 && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-installed-windows.ps1"
  },
  "dependencies": {
    "@plussub/srt-vtt-parser": "^2.0.5",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "smartcrop": "^2.0.5"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^44.4.5",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^5.0.1"
  },
  "build": {
    "appId": "com.aivideoeditor.desktop",
    "productName": "AI Video Editor",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!node_modules/ffprobe-static/bin/darwin/**",
      "!node_modules/ffprobe-static/bin/linux/**",
      "!node_modules/ffprobe-static/bin/win32/ia32/**"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/bin/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "AI-Video-Editor-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
